{
  "name": "yala-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend REST de Yala: gestor de gastos para adolescentes que construye un perfil financiero",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
