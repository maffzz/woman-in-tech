# ===== Servidor =====
PORT=4000
# URL del frontend (CORS y redirecciones tras el login con Google). Varias separadas por coma.
FRONTEND_URL=http://localhost:5173
# Secreto para firmar los tokens (JWT). CAMBIAR en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo
# 32+ caracteres. Cifra los tokens de Gmail guardados en la base.
ENCRYPTION_KEY=cambia-esto-por-otra-clave-larga-de-32-caracteres
DB_PATH=./data/yala.db
 
# ===== Modos =====
# auto = usa la IA real si hay clave del proveedor; si no usa respuestas de respaldo (cache)
AI_MODE=auto
# Proveedor de IA: claude | gemini  (por defecto claude)
AI_PROVIDER=claude
# true = habilita POST /auth/demo y los endpoints /demo/*
ALLOW_DEMO=true
# true = permite generar el certificado "demo" aunque el usuario sea menor de 18
ALLOW_DEMO_CERT=true
# true = permite POST /auth/dev-login (sin Google) para desarrollo
ALLOW_DEV_LOGIN=true

# ===== IA: Claude / Anthropic (opcional) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ===== IA: Gemini / Google AI (opcional) =====
# Nota: el plan gratuito de Gemini puede usar los datos para mejorar productos de Google.
# Solo usar con datos de demo; no enviar datos reales de usuarios.
GEMINI_API_KEY=
# Modelo recomendado para cuentas nuevas: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Google / Gmail (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la URL autorizada en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# Remitentes aceptados (separados por coma). Incluye Yape y BCP por defecto.
YAPE_SENDER=notificaciones@yape.com.pe,notificaciones@notificacionesbcp.com.pe
